# انسخ الملف ده باسم .env.local للتجربة المحلية، وعلى Vercel حطهم في Settings → Environment Variables

# رابط الاتصال من MongoDB Atlas (Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# اسم قاعدة البيانات
MONGODB_DB=wedding

# كلمة سر لوحة التحكم /admin — اختار كلمة قوية
ADMIN_KEY=change-me-to-a-long-random-password

# توقيت الإحصائيات اليومية (الأردن +03:00)
TZ_OFFSET=+03:00
